cabal-version:      2.4
name:               gestor-torneios
version:            0.1.0.0
build-type:         Simple

common comum
    default-language: Haskell2010
    ghc-options:      -Wall

library
    import:           comum
    hs-source-dirs:   src
    exposed-modules:  Model
                      Schedule
                      Standings
                      DadosExemplo
    build-depends:    base >=4 && <5

executable gestor-torneios
    import:           comum
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4 && <5, gestor-torneios

test-suite testes
    import:           comum
    type:             exitcode-stdio-1.0
    main-is:          TestMain.hs
    hs-source-dirs:   test
    build-depends:    base >=4 && <5, gestor-torneios
